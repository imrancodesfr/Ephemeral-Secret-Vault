# ── Ephemeral Secret Vault — environment example ─────────────────────────────
# Copy this file to `backend/.env` and fill in real values. The .env file is
# loaded automatically at startup and is NOT committed (see .gitignore). Do NOT
# place it in the project root — the loader only reads backend/.env.
#
# NEVER store additional copies of these secrets inside backend/data, beside the
# SQLite database, or anywhere in the repository.

# ENCRYPTION_KEY (REQUIRED for persisted vaults)
# A long random value used to encrypt vault secrets. If omitted, the process uses
# an ephemeral per-boot key: vaults created then become undecryptable after the
# process restarts. The app will print a loud warning in that case.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-a-long-random-hex-string

# JWT_SECRET (recommended)
# Signs session tokens (HS256). If omitted, a fresh random secret is generated at
# every boot, signing out everyone on restart.
JWT_SECRET=change-me-to-another-long-random-hex-string

# Simulation mode: set to false to stop labelling demo components as simulations.
# The project itself is a demonstration; true means badges/notes show "SIMULATION".
SIMULATION_MODE=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# How long a vault lives before the dead man's switch fires (minutes).
VAULT_EXPIRY_MINUTES=2
# Proof-of-work difficulty for the local (simulated) blockchain.
DEFAULT_DIFFICULTY=4
# How often the expiry monitor scans (milliseconds).
EXPIRY_CHECK_INTERVAL_MS=30000

# ── Optional Ethereum (Ganache) demo connection ───────────────────────────────
# Kept OFF by default. The demo only connects to a LOCAL node; never a public chain.
GANACHE_URL=http://127.0.0.1:7545

# ── Optional real SMTP ────────────────────────────────────────────────────────
# When enabled, notifications may additionally be sent by email (nodemailer must
# be installed). Without it the simulated in-app outbox is used and labeled as such.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ephemeral-vault@example.com